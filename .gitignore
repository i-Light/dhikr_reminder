# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/assets/SOURCE

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Staged build output + artifacts from scripts/build_windows.ps1
/dist/

# Generated from assets/images/app_icon.svg by tool/generate_app_icon.dart
/windows/runner/resources/app_icon.ico

# Android release signing — never commit
android/key.properties
*.jks
*.keystore
# Google Play API key used by scripts/publish_android.ps1 -- never commit
android/play-service-account.json
*service-account*.json

# Request service
/server/dev.sqlite*
/server/node_modules/
/server/.wrangler/
