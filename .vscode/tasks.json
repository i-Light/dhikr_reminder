{
  // CTRL + SHIFT + B to run the task
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Release",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\build_windows.ps1"
        // Add "-Installer" to also produce the Inno Setup .exe from
        // scripts\installer.iss (needs Inno Setup 6 installed); without it the
        // build always produces the portable .zip.
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Test",
      "type": "process",
      "command": "flutter",
      "args": ["test"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      // `flutter pub get` regenerates lib/l10n/gen/, so run this after
      // touching lib/l10n/*.arb or switching branches.
      "label": "Regenerate localizations",
      "type": "process",
      "command": "flutter",
      "args": ["gen-l10n"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none",
      "problemMatcher": []
    }
  ]
}
